#!/usr/bin/env bash

set -e

DOCKER_ENV=/etc/docker.env

# Populate the docker env file with all container environment variables.
install -m 600 /dev/null "${DOCKER_ENV}"
for var in $(compgen -e); do
	printf '%q=%q\n' "${var}" "${!var}"
done > "${DOCKER_ENV}"

# Append zero-conf certificates and other generated values to the docker env file,
# then render confd templates.
/etc/s6-overlay/scripts/configure-balena.sh

# Export the docker env file into the env of /init.
# s6 copies the env of /init to /run/s6/container_environment for with-contenv services.
set -a
# shellcheck disable=SC1090
source "${DOCKER_ENV}"
set +a

# start s6 overlay
exec /init "${@}"
